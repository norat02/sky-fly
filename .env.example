# ==============================================================================
# Whisper Environment Configuration
# ==============================================================================

# Supabase Production Backend (Required for real Supabase database, Auth, and Storage)
# Found in your Supabase project settings -> API:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Key for Server-Side Whisper SLM Translation Engine
GEMINI_API_KEY=

# OpenRouter Translation API Key (Optional, can also be configured in App Settings)
VITE_OPENROUTER_API_KEY=
