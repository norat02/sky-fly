# ==============================================================================
# Whisper environment configuration
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real credentials.
# ================================================================================

# ------------------------------------------------------------------------------
# Supabase — required for production auth, database, realtime and storage
# Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# OAuth providers are enabled in Supabase Dashboard -> Authentication -> Providers.
# The app maps Microsoft sign-in to Supabase provider `azure`.
# Provider console callback URL: https://<project-ref>.supabase.co/auth/v1/callback
# App redirect URLs belong in Supabase -> Authentication -> URL Configuration.

# ------------------------------------------------------------------------------
# Social OAuth provider credentials
# These are configured in the Supabase Dashboard, not in this frontend .env.
# Do not add provider client secrets here.
# ------------------------------------------------------------------------------
# Google: OAuth Client ID + Client Secret in Supabase Google provider
# Apple: Services ID, Team ID, Key ID + private key in Supabase Apple provider
# Microsoft: Entra Client ID + Client Secret in Supabase Azure provider

# ------------------------------------------------------------------------------
# Translation providers
# ------------------------------------------------------------------------------
# Preferred server-side Gemini key. Keep this secret and configure it on the server.
GEMINI_API_KEY=

# Optional client-side/provider fallbacks. These can be configured in App Settings.
# Treat VITE_* values as public once bundled into the browser.
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Optional Base44 compatibility / hosted runtime values
# Leave empty when running the standalone Supabase setup.
# ------------------------------------------------------------------------------
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=
BASE44_LEGACY_SDK_IMPORTS=

# Runtime mode used by the server entry point.
NODE_ENV=development

# ------------------------------------------------------------------------------
# Playwright E2E against staging
# ------------------------------------------------------------------------------
E2E_BASE_URL=https://staging.your-domain.com
# Set to 1 only when provider redirects should be exercised.
E2E_TEST_OAUTH_REDIRECTS=0
# Set to 1 only in a secure local/CI secret environment for full provider flows.
E2E_RUN_PROVIDER_AUTH=0
# Use dedicated, non-production test accounts. Never commit real values.
E2E_GOOGLE_EMAIL=
E2E_GOOGLE_PASSWORD=
E2E_APPLE_EMAIL=
E2E_APPLE_PASSWORD=
E2E_MICROSOFT_EMAIL=
E2E_MICROSOFT_PASSWORD=
